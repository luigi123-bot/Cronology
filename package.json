{
  "name": "cronology",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:build": "expo export --platform web",
    "web:serve": "node scripts/serve-web.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "node --loader ts-node/esm scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --loader ts-node/esm scripts/seed.ts",
    "build:android": "eas build --platform android --profile preview",
    "type-check": "tsc --noEmit",
    "sync:drive": "node scripts/sync-drive.js",
    "sync:movies": "node scripts/sync-movies.js",
    "sync:series": "node scripts/sync-series.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo/metro-runtime": "^57.0.15",
    "@expo/vector-icons": "^14.0.2",
    "@neondatabase/serverless": "^0.10.4",
    "@react-navigation/native": "^6.1.18",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.38.4",
    "expo": "~51.0.28",
    "expo-blur": "~13.0.2",
    "expo-constants": "~16.0.2",
    "expo-font": "~12.0.10",
    "expo-image": "~1.12.15",
    "expo-linear-gradient": "~13.0.2",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.23",
    "expo-splash-screen": "~0.27.6",
    "expo-status-bar": "~1.12.1",
    "expo-web-browser": "~13.0.3",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.74.5",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-web": "^0.19.13",
    "react-native-webview": "13.8.6",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.79",
    "@types/react-native": "~0.73.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "drizzle-kit": "^0.29.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
