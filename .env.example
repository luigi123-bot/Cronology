# DeepSeek API Key
DEEPSEEK_API_KEY=your_deepseek_api_key

# Neon Database
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require
NEON_AUTH_URL=https://endpoint.neonauth.neon.tech/neondb/auth
NEON_JWKS_URL=https://endpoint.neonauth.neon.tech/neondb/auth/.well-known/jwks.json

# Expo Public Variables
EXPO_PUBLIC_DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require
EXPO_PUBLIC_DEEPSEEK_API_KEY=your_deepseek_api_key
EXPO_PUBLIC_TMDB_API_KEY=your_tmdb_api_key
EXPO_PUBLIC_TMDB_BEARER_TOKEN=your_tmdb_bearer_token
EXPO_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3
EXPO_PUBLIC_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p/w500
EXPO_PUBLIC_YOUTUBE_API_KEY=your_youtube_api_key
